{
  "info": {
    "_postman_id": "7f8b92c4-3d12-4e67-8910-bc56a29e4182",
    "name": "PenAgent - Component 2 (Hypothesis Generation Service)",
    "description": "Postman Collection for Component 2: Hypothesis Generation Service (HGS). Contains dedicated requests for all 3 targets: SREBench-API, OWASP Juice Shop, and DVWS-Node.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. System & Shared Controls",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Verifies that the Hypothesis Generation Service is up and responsive."
          },
          "response": []
        },
        {
          "name": "Get Batch by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/hypotheses/:batch_id",
              "host": ["{{base_url}}"],
              "path": ["v1", "hypotheses", ":batch_id"],
              "variable": [
                {
                  "key": "batch_id",
                  "value": "batch_example_id",
                  "description": "Batch ID returned from any POST /v1/hypotheses/generate"
                }
              ]
            },
            "description": "Retrieves the full ranked batch of hypotheses for a given batch ID."
          },
          "response": []
        },
        {
          "name": "Report Feedback (Confirmed Finding -> Trigger Replan)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"confirmed_vulnerability\",\n  \"status_code\": 200,\n  \"evidence\": \"Successfully accessed unauthorized object without tenant verification\",\n  \"discovered_state\": {\n    \"leaked_id\": \"usr_102\",\n    \"auth_token\": \"eyJhbGciOi...\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/hypotheses/:hypothesis_id/feedback",
              "host": ["{{base_url}}"],
              "path": ["v1", "hypotheses", ":hypothesis_id", "feedback"],
              "variable": [
                {
                  "key": "hypothesis_id",
                  "value": "hyp_example_id",
                  "description": "ID of the probed hypothesis"
                }
              ]
            },
            "description": "Reports confirmed vulnerability outcome. Sets status to 'confirmed', boosts dependent hypotheses, and triggers an automatic replan."
          },
          "response": []
        },
        {
          "name": "Report Feedback (Negative Finding)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"negative\",\n  \"status_code\": 403,\n  \"evidence\": \"Access forbidden: Tenant isolation check passed\",\n  \"discovered_state\": {}\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/hypotheses/:hypothesis_id/feedback",
              "host": ["{{base_url}}"],
              "path": ["v1", "hypotheses", ":hypothesis_id", "feedback"],
              "variable": [
                {
                  "key": "hypothesis_id",
                  "value": "hyp_example_id",
                  "description": "ID of the probed hypothesis"
                }
              ]
            },
            "description": "Marks a hypothesis as done/negative, adjusting score priors without triggering a replan."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. SREBench-API (Target: srebench)",
      "item": [
        {
          "name": "1.1 Generate Initial Hypotheses (srebench)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_id\": \"srebench\",\n  \"mode\": \"initial\",\n  \"knowledge_state_delta\": {},\n  \"prior_findings\": [],\n  \"max_hypotheses\": 15\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/hypotheses/generate",
              "host": ["{{base_url}}"],
              "path": ["v1", "hypotheses", "generate"]
            },
            "description": "Generates prioritized hypotheses for SREBench-API, synthesizing cross-service exploit chains (Auth -> Users -> Vault)."
          },
          "response": []
        },
        {
          "name": "1.2 Generate Replan Hypotheses (srebench - SRE-01)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_id\": \"srebench\",\n  \"mode\": \"replan\",\n  \"knowledge_state_delta\": {\n    \"user_id\": \"usr_102\",\n    \"service_token\": \"st_auth_service_internal_xyz\"\n  },\n  \"prior_findings\": [\n    {\n      \"scenario\": \"SRE-01\",\n      \"title\": \"User Tenant Leaked\",\n      \"evidence\": \"GET /users/v1/profile/usr_102 leaked Bob's tenant ID and doc_id\"\n    }\n  ],\n  \"max_hypotheses\": 10\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/hypotheses/generate",
              "host": ["{{base_url}}"],
              "path": ["v1", "hypotheses", "generate"]
            },
            "description": "Synthesizes chained follow-up hypotheses exploiting leaked usr_102 and service_token to access /vault/v1/documents."
          },
          "response": []
        },
        {
          "name": "1.3 Pop Next Hypothesis (srebench)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/queue/srebench/next",
              "host": ["{{base_url}}"],
              "path": ["v1", "queue", "srebench", "next"]
            },
            "description": "Pops the highest-priority pending hypothesis for SREBench. Transitions status to 'in_progress'."
          },
          "response": []
        },
        {
          "name": "1.4 Peek Queue (srebench)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/queue/srebench?limit=25",
              "host": ["{{base_url}}"],
              "path": ["v1", "queue", "srebench"],
              "query": [
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            },
            "description": "Peeks at the current queued hypotheses for SREBench ordered by priority score descending."
          },
          "response": []
        },
        {
          "name": "1.5 Trigger Replan Event (srebench)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_id\": \"srebench\",\n  \"finding_id\": \"FINDING-SRE01\",\n  \"owasp_category\": \"API1:BOLA\",\n  \"knowledge_delta\": {\n    \"service_token\": \"eyJhbGciOi...\",\n    \"doc_id\": \"doc_002\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/events/replan",
              "host": ["{{base_url}}"],
              "path": ["v1", "events", "replan"]
            },
            "description": "Triggers dynamic replanning for SREBench upon receiving a finding.significant event."
          },
          "response": []
        }
      ]
    },
