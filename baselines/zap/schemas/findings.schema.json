{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PenAgent ZAP common normalized findings v1",
  "type": "object",
  "required": ["schema_version", "tool", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "tool": {"enum": ["zap", "penagent"]},
    "raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target", "tool", "endpoint", "method", "category", "parameter", "risk", "confidence", "evidence_refs", "independently_verified", "provenance", "occurrences"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "target": {"type": "string"},
          "tool": {"enum": ["zap", "penagent"]},
          "endpoint": {"type": "string", "pattern": "^/"},
          "method": {"type": ["string", "null"]},
          "category": {"type": "string", "pattern": "^(CWE-[0-9]+|UNMAPPED)$"},
          "parameter": {"type": ["string", "null"]},
          "object": {"type": ["string", "null"]},
          "risk": {"type": ["string", "null"]},
          "confidence": {"type": ["string", "number", "null"]},
          "tool_classification": {"type": ["string", "null"]},
          "independently_verified": {"const": false},
          "provenance": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "instances": {"type": "array"},
          "occurrences": {"type": "array", "minItems": 1}
        }
      }
    }
  }
}
