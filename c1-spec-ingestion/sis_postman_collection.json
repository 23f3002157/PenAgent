          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Verifies that the Spec Ingestion Service is up and responsive."
          },
          "response": []
        },
        {
          "name": "Get Ingestion Job Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/ingest/:job_id",
              "host": ["{{base_url}}"],
              "path": ["v1", "ingest", ":job_id"],
              "variable": [
                {
                  "key": "job_id",
                  "value": "job_1b69617c8edb",
                  "description": "The job ID returned from any POST /v1/ingest request"
                }
              ]
            },
            "description": "Polls the status of an ongoing or completed spec ingestion job (queued | parsing | building_graph | tagging | done | failed)."
          },
          "response": []
        }
      ]
