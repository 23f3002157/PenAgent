# Copy to .env, or use demo.prepare_docker to generate local service credentials.
# Never paste API keys into chat. GOOGLE_API_KEY takes precedence over GEMINI_API_KEY.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
# Verified models depend on the key. Use demo.gemini_check before selecting.
PENAGENT_LLM_PROVIDER=none
# Enable gemini only after configuring a model verified for your key.
